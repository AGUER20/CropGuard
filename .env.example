# Copy this file to .env and fill in real values before running the app.

# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string

# MySQL database (Table 1 of the proposal: MySQL is the chosen DBMS)
# Create the database first:  CREATE DATABASE cropguard_db;
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cropguard_db

# Trained model (Spiral 2/3 deliverable). If this file does not exist yet,
# the app automatically falls back to a deterministic demo predictor so the
# whole system stays runnable end-to-end while the real MobileNetV2 model
# is being trained (see app/ml/inference.py).
MODEL_PATH=model/mobilenetv2_cropguard.h5
CLASS_INDEX_PATH=model/class_indices.json

# Upload limits
MAX_CONTENT_LENGTH_MB=8
